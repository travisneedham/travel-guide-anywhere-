<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="40dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_settings"
                android:contentDescription="@string/settings_title" />
        </LinearLayout>

        <!-- Primary mode toggle: Live / Trip -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_live"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_live" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_trip"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_route" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Route URL card (visible only in Route mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_route_url"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste Google Maps directions link">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_route_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="2"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_route_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Route ready: 5.2 mi, ~12m"
                    tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sort toggle: Closest First / Most Famous First -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_closest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/mode_sort_closest" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_famous"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/mode_sort_famous" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Range card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_range_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    tools:text="Searching within 1 mile" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/range_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="17"
                    android:stepSize="1"
                    android:value="7"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Idle hint -->
        <TextView
            android:id="@+id/tv_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/idle_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Status card (hidden when idle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- POI photo (shown when a Wikipedia/Wikidata image is available) -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_poi_image"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="View full image"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
                    tools:visibility="visible"
                    tools:src="@color/stroke" />

                <TextView
                    android:id="@+id/tv_image_credit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_credit"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="end"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent"
                        app:indicatorSize="20dp"
                        app:trackThickness="2dp"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        tools:text="Speaking" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_topic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Narrating: Lincoln Memorial"
                    tools:visibility="visible" />

                <!-- Deep Dive list (numbered titles built up during deep dive mode) -->
                <LinearLayout
                    android:id="@+id/ll_deep_dive_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <!-- Now-playing action bar: navigate, wikipedia, want-to-visit, thumbs-down -->
                <LinearLayout
                    android:id="@+id/layout_poi_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_poi_navigate"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_navigate"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Open in Maps"
                        android:padding="8dp" />

                    <ImageButton
                        android:id="@+id/btn_poi_wikipedia"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_language"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Open Wikipedia article"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_poi_want_to_visit"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_favorite_border"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Want to Visit"
                        android:padding="8dp" />

                    <ImageButton
                        android:id="@+id/btn_poi_thumbs_down"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_thumb_down"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Not interested"
                        android:padding="8dp"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <!-- Pause / Skip / Deep Dive controls — visible only while tour is active -->
                <LinearLayout
                    android:id="@+id/layout_playback_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pause"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:maxLines="1"
                            android:text="@string/btn_pause"
                            app:icon="@drawable/ic_pause"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconPadding="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_skip"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_skip"
                            app:icon="@drawable/ic_skip"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deep_dive"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Deep Dive"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GO button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_go"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- STOP button (hidden when idle) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_stop"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/stop_color"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Places Covered button — opens the full interactive bottom sheet -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_places_covered"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="Places Covered (0)"
            android:visibility="gone"
            app:strokeColor="@color/stroke"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
